# Server Environment Configuration
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# MongoDB Connection String (Atlas URI or local mongodb://127.0.0.1:27017/devpulse)
# If left empty, DevPulse automatically boots an in-memory embedded MongoDB engine for instant zero-config evaluation.
MONGODB_URI=

# JWT Secret Key for token signing & verification (minimum 32 characters recommended)
JWT_SECRET=devpulse_super_secure_jwt_secret_token_key_capstone_2026
JWT_EXPIRES_IN=7d
